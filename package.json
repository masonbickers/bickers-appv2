{
  "name": "bickers-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "api": "node server/index.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:web:visual": "cross-env EXPO_PUBLIC_VISUAL_TEST_MODE=1 expo export --platform web",
    "preview:web": "npx serve dist",
    "lint": "expo lint",
    "test": "node --experimental-default-type=module --test tests/*.test.js",
    "test:visual": "npm run build:web:visual && playwright test",
    "test:visual:update": "npm run build:web:visual && playwright test --update-snapshots",
    "visual:serve": "serve -s dist -l 4173",
    "test:booking-visibility": "node --experimental-default-type=module --test tests/bookingVisibility.test.js"
  },
  "overrides": {
    "react-native-safe-area-context": "~5.6.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "base-64": "^1.0.0",
    "date-fns": "^4.1.0",
    "expo": "~55.0.31",
    "expo-application": "~55.0.19",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.30",
    "expo-web-browser": "~55.0.20",
    "firebase": "^12.5.0",
    "lucide-react-native": "^0.545.0",
    "memoize-one": "^6.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-calendars": "^1.1313.0",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.2.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.1",
    "serve": "^14.2.6",
    "typescript": "~5.9.2"
  }
}
